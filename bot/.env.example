# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# Test server ID. Slash commands sync instantly to one guild, while global sync takes up to an hour.
GUILD_ID=
DB_PATH=data/registrar.db
CURRICULUM_DIR=../curriculum
UNLOCKS_PATH=config/unlocks.yaml
LOG_LEVEL=INFO
# Where the site lives. Pins, /site and /card link here. Use the public address once the site is online.
SITE_URL=http://localhost:3000
