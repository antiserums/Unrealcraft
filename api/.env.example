# Copy to .env and fill in. Never commit .env.

# Discord application (Developer Portal -> your app -> OAuth2). The bot and the website share one application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be listed under OAuth2 -> Redirects in the Developer Portal, exactly.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# The Unrealcraft server. Only members of this server can log in.
DISCORD_GUILD_ID=

# Long random string. Signs the session cookie. Change it to log everyone out.
SESSION_SECRET=

# Where the website lives (used for redirects after login).
WEB_ORIGIN=http://localhost:3000

# Shared with the bot: the same SQLite file and the same curriculum folder.
DB_PATH=../bot/data/registrar.db
CURRICULUM_DIR=../curriculum
CHANGELOG_PATH=../CHANGELOG.md
UPLOADS_DIR=data/uploads

# Long random string the bot uses to call /bot/* endpoints (phase 2+).
BOT_SERVICE_TOKEN=

LOG_LEVEL=INFO

# Local testing only: GET /api/auth/dev-login logs in as this Discord id without Discord. Leave empty normally.
DEV_LOGIN_ID=

# Staff (comma-separated Discord ids).
ADMIN_IDS=            # everything unlocked for testing, admin panel, review inbox; nameplate 'Admin'
DEVELOPER_IDS=        # same powers as admins; nameplate 'Developer' (the local dev login counts as one)
MENTOR_IDS=           # review inbox only; nameplate 'Mentor' (the Discord mentor role also counts)
